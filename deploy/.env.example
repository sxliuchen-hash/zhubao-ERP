ZHUBAO_IMAGE_TAG=local
ZHUBAO_BACKEND_IMAGE=zhubao-erp-backend
ZHUBAO_FRONTEND_IMAGE=zhubao-erp-frontend
ZHUBAO_MYSQL_IMAGE=mysql:8.4

ZHUBAO_HTTP_PORT=80
ZHUBAO_HTTPS_PORT=443
ZHUBAO_BACKEND_PORT=8080
# 手机打开摄像头要用 HTTPS。填写手机访问时用的 IP 或域名，多个用英文逗号。
# 例：192.168.1.20 或 erp.local。改这一项后重启前端容器会按新地址重签自签证书。
ZHUBAO_TLS_SAN=
ZHUBAO_PUBLIC_URL=http://localhost/
ZHUBAO_FRONTEND_PROBE_URL=http://frontend/
ZHUBAO_FRONTEND_PROBE_TIMEOUT_MS=800
ZHUBAO_RESTORE_DRILL_MAX_AGE_HOURS=168

ZHUBAO_DB_NAME=zhubao_erp
ZHUBAO_DB_USERNAME=zhubao
ZHUBAO_DB_PASSWORD=change-me
ZHUBAO_DB_ROOT_PASSWORD=change-root-me

ZHUBAO_BUSINESS_REPOSITORY=jdbc
ZHUBAO_APPROVAL_REPOSITORY=jdbc
ZHUBAO_DOCUMENTS_REPOSITORY=jdbc
ZHUBAO_AUTH_USERS_REPOSITORY=jdbc
ZHUBAO_AUTH_AUDIT_REPOSITORY=jdbc

# 运维中心展示腾讯云 COS 异地备份准备情况。
# 不要在本文件填写 SecretId/SecretKey；请在服务器使用 coscmd 配置或临时凭证。
ZHUBAO_COS_BACKUP_ENABLED=false
ZHUBAO_COS_BACKUP_BUCKET=
ZHUBAO_COS_BACKUP_REGION=
ZHUBAO_COS_BACKUP_PREFIX=prod/mysql/
ZHUBAO_COS_BACKUP_CREDENTIALS_MODE=
ZHUBAO_COS_BACKUP_LIFECYCLE_POLICY=

# MySQL 生产模式必须配置至少 32 字符的随机附件预览签名密钥，不能沿用开发默认值。
ZHUBAO_DOCUMENT_PREVIEW_SECRET=
