<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 只信任系统证书。证书校验失败时由 WebView 中止，不得放行。 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
