digraph G {
  graph [fontname="SimSun", fontsize=22, label="02 目标业务架构｜蓝色沿用，橙色为拟新增或改造", labelloc=t, rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.3",ranksep="0.5"];
  node [fontname="SimSun",fontsize=16,shape=box,style="rounded,filled",color="#2563eb",fillcolor="#eff6ff",margin="0.16,0.12"];
  edge [fontname="SimSun",fontsize=12,color="#64748b",arrowsize=0.7];
  ui [label="沿用订单工作区与现场办理入口\n扫码→拍照→数量→提交"];
  query [label="统一加工目标与可办理查询【改造】\n按钮、详情、扫码读取相同事实",color="#b45309",fillcolor="#fff7ed",style="rounded,filled,dashed"];
  subgraph cluster_business {
    label="business：加工与交付事实";color="#94a3b8";fontname="SimSun";fontsize=18;
    original [label="母单／子单／来源\n原始来料与委托身份"];
    route [label="材质默认路线＋本单路线快照\n稳定工序身份【改造】",color="#b45309",fillcolor="#fff7ed",style="rounded,filled,dashed"];
    bag [label="实物袋与分袋关系【新增】\n单材质、单要求、单来源",color="#b45309",fillcolor="#fff7ed",style="rounded,filled,dashed"];
    facts [label="报工批次／数量处置／质量份额【改造】\n工序、质量、交付各自留事实",color="#b45309",fillcolor="#fff7ed",style="rounded,filled,dashed"];
    shipment [label="独立发货汇总＋逐袋来源【新增】\n一张发货单关联多加工目标",color="#b45309",fillcolor="#fff7ed",style="rounded,filled,dashed"];
    original -> route; route -> bag; bag -> facts; facts -> shipment;
  }
  ui -> query; query -> bag; query -> facts;
  unit [label="沿用同一业务工作单元\n事实、袋分配、库存与请求结果一起提交"];
  facts -> unit; shipment -> unit;
  stock [label="沿用库存台账\n袋分配明细不能成为另一套库存"];
  doc [label="沿用附件存储【扩展引用事务】\n先上传，再随报工绑定照片",color="#b45309",fillcolor="#fff7ed",style="rounded,filled,dashed"];
  delivery [label="交齐判定【改造】\n逐袋净交付＋有效处置闭合",color="#b45309",fillcolor="#fff7ed",style="rounded,filled,dashed"];
  money [label="客户按次出账／员工整单核算【改造】\n确认分离，沿用应收、工资和收付款",color="#b45309",fillcolor="#fff7ed",style="rounded,filled,dashed"];
  print [label="保留厂内40×30\n新增发货40×30＋A5",color="#b45309",fillcolor="#fff7ed",style="rounded,filled,dashed"];
  public [label="客户公开交付页【新增】\n内部详情仍按岗位与财务权限",color="#b45309",fillcolor="#fff7ed",style="rounded,filled,dashed"];
  unit -> stock; unit -> doc;
  shipment -> delivery;
  shipment -> money [label="客户按本次已发"];
  delivery -> money [label="员工按整单完成"];
  shipment -> print; shipment -> public;
  separate [label="本版：独立打样、独立金工\n各自路线、版本、计量与收费资格\n共用库存、证据及费用技术",color="#b45309",fillcolor="#fff7ed"];
  original -> separate [style=dashed,label="可选关联",dir=both];
}
