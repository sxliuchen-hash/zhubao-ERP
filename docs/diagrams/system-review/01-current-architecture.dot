digraph G {
  graph [fontname="SimSun", fontsize=22, label="01 现有系统架构｜源码核对基准：85b3149", labelloc=t, rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.55"];
  node [fontname="SimSun", fontsize=16, shape=box, style="rounded,filled", color="#2563eb", fillcolor="#eff6ff", margin="0.18,0.12"];
  edge [fontname="SimSun", fontsize=12, color="#64748b", arrowsize=0.7];
  desktop [label="电脑浏览器"];
  mobile [label="手机网页 / PWA / 安卓容器"];
  ui [label="Vue 3 共享界面\n订单工作区＋收货／生产／质量／发货动作"];
  desktop -> ui; mobile -> ui;
  subgraph cluster_server {
    label="一个 Spring Boot 后端｜模块化单体，模块不是独立微服务"; color="#94a3b8"; fontname="SimSun"; fontsize=18;
    guard [label="身份、岗位／顶岗、数据范围\n服务端逐请求鉴权"];
    app [label="应用服务协调真实业务\n收料、拆单、交工、质检、发货、结单"];
    work [label="统一命令工作单元\n库存＋单据＋请求结果同次提交"];
    inventory [label="库存领域\n唯一库存台账与余额"];
    finance [label="财务领域\n应收、工资、应付、收付款"];
    documents [label="附件与证据领域\n原件、元数据、操作引用"];
    labels [label="标签与打印领域\n模板、冻结PNG、工位任务"];
    support [label="客户／配置／审批／运维\n登记导入与设备等必要依赖"];
    guard -> app; app -> work;
    work -> inventory; work -> finance;
    app -> documents; app -> labels; app -> support;
  }
  ui -> guard [label="HTTPS API"];
  db [shape=cylinder,label="MySQL / JDBC\n各仓储按配置装配"];
  files [shape=folder,label="附件原件目录\n与数据库成套备份"];
  mem [label="本地内存实现\n用于默认本地模式", color="#71717a", fillcolor="#fafafa"];
  agent [label="现有厂内工位程序\n40×30标签打印机"];
  inventory -> db; finance -> db; documents -> db; labels -> db;
  documents -> files [label="文件不属于数据库事务"];
  work -> mem [style=dashed,label="可切换实现"];
  labels -> agent [label="领取冻结原图"];
  scope [shape=note,label="现有三工序、整单质量和单来源出库\n不等于本轮拟建设的袋级完整流程", color="#71717a",fillcolor="#fafafa"];
  app -> scope [style=dashed,arrowhead=none];
}
