digraph G {
  graph [fontname="SimSun",fontsize=22,label="10 加工主线开发依赖｜统一模型，集成验收后整版切换",labelloc=t,rankdir=TB,bgcolor="white",pad="0.3",nodesep="0.45",ranksep="0.55"];
  node [fontname="SimSun",fontsize=16,shape=box,style="rounded,filled",color="#b45309",fillcolor="#fff7ed",margin="0.18,0.12"];
  edge [fontname="SimSun",fontsize=12,color="#64748b",arrowsize=0.7];
  p0 [label="P0 存量样本与统一解析验收\n原母单／工单码／照片及收货来源\n库存漏查与重量差异据实核对",color="#2563eb",fillcolor="#eff6ff"];
  p12 [label="P1＋P2 身份与基础\n材质路线、来源、袋及旧码兼容"];
  p34 [label="P3＋P4 现场生产纵向试验\n拍照、实际数量、损耗、部分质检返工"];
  p56 [label="P5＋P6 交付与财务接续\n客户按次出账，员工整单核算\n灵活算法、历史覆盖与独立权限"];
  p7 [label="P7 输出与设备\n旧厂内样式保持\n新40×30发货标签＋A5"];
  p8 [label="P8 对外扫码\n公开交付页＋内部授权详情"];
  p9 [label="P9 集成验收、接续演练及集中切换\n原母单接入统一新模型，原码原照保留\n一期外协／物料／客户库存依赖另见整体图"];
  retain [label="整个过程中保持\n库存唯一台账、同事务、有效权限\n原请求回放、旧标签、备份恢复",color="#71717a",fillcolor="#fafafa"];
  p0 -> p12 [label="基础资产与来源核对"];
  p12 -> p34; p34 -> p56;
  p56 -> p7; p56 -> p8;
  p7 -> p9; p8 -> p9;
  retain -> p34 [style=dashed,arrowhead=none]; retain -> p56 [style=dashed,arrowhead=none];
}
