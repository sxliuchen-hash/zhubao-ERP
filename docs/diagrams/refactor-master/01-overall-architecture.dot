digraph G {
 graph [fontname="SimSun",fontsize=23,label="整体目标架构｜三类业务独立，共用库存、交付、费用与证据",labelloc=t,rankdir=TB,bgcolor="white",pad="0.3",nodesep="0.4",ranksep="0.6"];
 node [fontname="SimSun",fontsize=17,shape=box,style="rounded,filled",color="#b45309",fillcolor="#fff7ed",margin="0.2,0.14"];
 edge [fontname="SimSun",fontsize=13,color="#64748b",arrowsize=0.7];
 staff [label="厂内电脑／手机\n扫码报工、库管、财务",color="#2563eb",fillcolor="#eff6ff"];
 client [label="客户手机网页登录\n只读自己的物料与加工库存"];
 public [label="公开发货扫码\n只读指定交付摘要"];
 {rank=same;staff;client;public;}
 access [label="登录与服务端授权\n内部有效岗位／顶岗；客户稳定身份绑定；公开字段白名单\n明细、照片、下载及导出均验证数据范围",color="#2563eb",fillcolor="#eff6ff"];
 contract [label="共用业务契约\n业务类型＋稳定身份；权属与来源；计量、袋份额及交付／收费资格\n数量手填保留，预留拍照计数回填；不新增通用流程引擎",color="#71717a",fillcolor="#fafafa"];
 subgraph cluster_domains {
  label="本版三类独立业务｜各自状态、路线、完结与费用条件";fontname="SimSun";fontsize=19;color="#cbd5e1";
  production [label="普通加工\n保护母单原号／码／照片\n单来源分袋、拍照报工\n实际损耗、部分质量及返工"];
  sample [label="独立打样\n需求版本、平设建模、珠型确认\n来料／自备料加工、分次交付\n每次交付确认样费或明确免收"];
  gold [label="独立金工\n平设建模、倒模、执模、抛光金\n核定件数／重量／成色深度\n投入产出、回收补料及质量"];
  {rank=same;production;sample;gold;}
 }
 delivery [label="共用交付及打印技术\n独立发货号＋逐袋来源，确认才出库\n厂内40×30外观保持；发货40×30＋独立A5\n三类业务能否混合发货需先核定"];
 inventory [label="唯一实物数量账\n客户／公司权属、本厂／外协保管\n寄存、在制、可交、回收及退料\n袋是份额明细，不另立总余额"];
 finance [label="共用费用及资金技术\n普通客户按次出账，员工整单核算\n打样按次样费；金工收费细则待核\n应收、员工应付、外协费用各有来源"];
 {rank=same;delivery;inventory;finance;}
 outsourcing [label="外协发外与分批收回\n原权属／来源／节点，在外量可追\n外发不是客户发货，外协费不是工资"];
 factory [label="本厂物料／耗材／工具\n入库、领退、实际耗用／借还\n同物唯一数量来源，成本不重复"];
 asset [label="本版固定资产增强\n保留原资产ID及已记折旧\n实物卡、交接、维修、盘点及处置"];
 {rank=same;outsourcing;factory;asset;}
 evidence [label="附件及设计版本引用\n报工照片随事实同次绑定\n3DM／STL／OBJ／CAD保留格式及位置引用\n通常上传预览图、PDF；不强制存大模型"];
 base [label="保留的技术与数据底座\nBusinessWorkUnit／WorkSession；DDD四层；内存／JDBC；审计、附件、备份及升级\n复用应收、工资、应付与收付款；追加迁移，不重复收货／入库／记费",color="#2563eb",fillcolor="#eff6ff"];
 note [shape=note,label="统一模型分小节点建设，全部确认范围整版验收后集中切换。\n三业务可轻度关联，不互为正常加工前置；登记导入入口仍保留原职责。\n拍照计数算法后续接入；金工精度、资产处置等未决只限制对应节点。",color="#71717a",fillcolor="#fafafa"];
 staff -> access;client -> access;public -> access;access -> contract;
 contract -> production;contract -> sample;contract -> gold;
 production -> delivery;sample -> delivery;gold -> delivery;
 production -> inventory;sample -> inventory;gold -> inventory;
 delivery -> finance [label="各业务确认自己的收费资格"];
 inventory -> outsourcing [label="保管流转"];
 inventory -> factory [label="公司料适用"];
 finance -> asset [label="资产费用有独立依据"];
 outsourcing -> base;factory -> base;asset -> base;
 delivery -> evidence [label="确认快照"];
 evidence -> base;
 finance -> base;inventory -> base;
 base -> note [style=dashed,arrowhead=none];
}
