digraph G {
 graph [fontname="SimSun",fontsize=23,label="整版交付依赖｜统一模型，小步实现，完整验收后集中切换",labelloc=t,rankdir=TB,bgcolor="white",pad="0.3",nodesep="0.45",ranksep="0.6"];
 node [fontname="SimSun",fontsize=17,shape=box,style="rounded,filled",color="#b45309",fillcolor="#fff7ed",margin="0.2,0.14"];
 edge [fontname="SimSun",fontsize=13,color="#64748b",arrowsize=0.7];
 baseline [label="资产基准与只读核对｜P0、I0\n保护母单、原工单码与标签、照片及原收货来源\n其他少量真实下游先核清，不假定空库",color="#2563eb",fillcolor="#eff6ff"];
 model [label="共用模型及业务门槛｜P1—P2\n三类独立业务身份、权属来源、袋、计量、证据及收费资格\n先核定金工精度等关键细则，设计一次性存量接续"];
 normal [label="普通加工与外协｜P3—P4、O1\n拍照报工、实际数量及损耗\n部分质检／返工，发外与分批收回"];
 sampling [label="独立打样｜S1\n版本／珠型确认、加工、分次交付\n按次样费或明确免收"];
 gold [label="独立金工｜M1\n实际路线、投入产出、回收及补料\n质量、交付与核定费用"];
 {rank=same;normal;sampling;gold;}
 delivery [label="交付、财务及打印｜P5—P8、F1—F6\n独立发货、分离收费资格、账款核销\n保留厂内40×30，新发货40×30及独立A5"];
 factory [label="本厂物料工具及资产｜I3—I4、A1\n珠料、配件、耗材、刀具与工具\n固定资产实物、维修、盘点及折旧连续性"];
 customer [label="客户只读｜I1—I2\n手机网页登录查自己的本厂／外协库存\n明细、照片与下载同一授权"];
 {rank=same;delivery;factory;customer;}
 integration [label="整版全链集成验收｜P9与GR-Z01—Z11\n普通加工、打样、金工、物料工具、资产及客户入口均贯通\n失败、并发、越权、目标数据库、真实手机与出纸核验",color="#2563eb",fillcolor="#eff6ff"];
 rehearsal [label="存量接续、恢复及交付材料\n母单原号／码／照／数量来源前后核对\n不重复收货／入库，不造工序或费用；明确旧写口退出"];
 cutover [label="明确授权后的维护窗口切换｜GR-Z14\n最终备份、接续核对、统一新版本启用\n旧码进入新模型；已有新事实后用兼容修复及追加更正",color="#2563eb",fillcolor="#eff6ff"];
 future [label="后续C1\n实际拍照计数算法及适配\n当前手填＋数量来源契约已保留",color="#71717a",fillcolor="#fafafa"];
 note [shape=note,label="开发按105个小节点逐卡提交，组间箭头仅示意业务依赖。\n准确前置条件以Grok任务册为准；每卡完成后停止，不自动连做全册。\n资产、打样及金工属于本次完整版本；大模型通常只存位置和轻量确认凭据。",color="#71717a",fillcolor="#fafafa"];
 baseline -> model;model -> normal;model -> sampling;model -> gold;model -> factory;
 normal -> delivery;sampling -> delivery;gold -> delivery;
 delivery -> customer;delivery -> integration;factory -> integration;customer -> integration;
 integration -> rehearsal;rehearsal -> cutover;
 cutover -> future [style=dashed,label="算法另行开发"];
 cutover -> note [style=dashed,arrowhead=none];
}
