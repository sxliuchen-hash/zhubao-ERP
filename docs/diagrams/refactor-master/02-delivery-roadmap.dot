digraph G {
 graph [fontname="SimSun",fontsize=23,label="整体重构交付依赖｜统一模型建设，一期完整验收后集中切换",labelloc=t,rankdir=TB,bgcolor="white",pad="0.3",nodesep="0.5",ranksep="0.6"];
 node [fontname="SimSun",fontsize=17,shape=box,style="rounded,filled",color="#b45309",fillcolor="#fff7ed",margin="0.2,0.14"];
 edge [fontname="SimSun",fontsize=13,color="#64748b",arrowsize=0.7];
 assets [label="资产基准与只读核对｜P0、I0\n重点保护母单、原工单码与标签、照片\n连同原收货来源及少量真实下游核实",color="#2563eb",fillcolor="#eff6ff"];
 model [label="统一新模型｜P1—P2及共用契约\n目标、来源、路线、袋、计量、保管与费用身份\n设计一次性接续映射，不长期维护完整旧流程"];
 production [label="加工、质量与外协｜P3—P4、O1\n实际数量、拍照报工、部分质量／返工\n发外、分批收回与在外量"];
 delivery [label="交付、财务与打印｜P5—P8、F1—F6\n独立发货、客户按次账、员工整单费\n厂内样式保持，新发货40×30及独立A5"];
 factory [label="本厂物料工具｜I3—I4\n珠料、配件、耗材、刀具和工具\n统一领退、耗用／借还及数量来源"];
 customer [label="客户只读｜I1—I2\n手机网页登录查自己的本厂／外协库存\n明细、照片与下载同一授权"];
 integration [label="一期全链集成验收｜P9\n上述首期范围在同一版本贯通\n失败、并发、越权、真实手机及出纸核验",color="#2563eb",fillcolor="#eff6ff"];
 rehearsal [label="存量接续与恢复演练｜适用I5及迁移\n母单原号、原码、原照、库存来源前后核对\n不重复收货／入库，不造工序或期初费用"];
 cutover [label="维护窗口集中切换\n最终备份、接续核对、统一新版本启用\n旧码进新模型，退出的旧业务写口停止",color="#2563eb",fillcolor="#eff6ff"];
 future [label="后续增强\nA1资产实物增强；C1拍照计数算法\n打样／金工专属流程另定，首期保留必要边界",color="#71717a",fillcolor="#fafafa"];
 note [shape=note,label="开发分阶段和小提交，生产首发以一期完整闭环为边界。\n未深度使用不等于其他数据为零，实际记录先核对。\n新写入放开前可停止切换；已有新事实后使用兼容修复和追加更正。",color="#71717a",fillcolor="#fafafa"];
 assets -> model;model -> production;model -> factory;
 production -> delivery;production -> customer;delivery -> customer;
 delivery -> integration;factory -> integration;customer -> integration;
 integration -> rehearsal;rehearsal -> cutover;
 cutover -> future [style=dashed,label="已明确后置范围"];
 cutover -> note [style=dashed,arrowhead=none];future -> note [style=dashed,arrowhead=none];
}
